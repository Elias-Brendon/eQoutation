{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vitest*.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "./out/.tsc-node",
    "emitDeclarationOnly": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  }
}
